# Chronicle settings (copy to .env.local). Next expands $VAR / ${VAR} here, so a key can be
# written once and referenced (LLM_CF_API_KEY=${CLOUDFLARE_API_TOKEN}). docs/PROTOTYPE_PLAN.md.

# ---------------------------------------------------------------- LLM (section 4)
# Which LLMs answer, in order. The next one is used only when the one before fails before anything
# reached the learner. Any OpenAI-compatible API works: Cloudflare, Gemini, Groq, OpenRouter, Ollama.
LLM_CHAIN=cf,openrouter

# Cloudflare Workers AI, free 10,000 neurons a day (a lesson is about 250-350).
# gpt-oss-120b streams clean JSON; Llama 3.3 / 4, Mistral Small and Qwen3 30B stream corrupted
# JSON on Cloudflare (numbers arrive as typed values) and are refused by the adapter.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
LLM_CF_BASE_URL=https://api.cloudflare.com/client/v4/accounts/${CLOUDFLARE_ACCOUNT_ID}/ai/v1
LLM_CF_API_KEY=${CLOUDFLARE_API_TOKEN}
LLM_CF_MODEL=@cf/openai/gpt-oss-120b
LLM_CF_REASONING_EFFORT=low

# OpenRouter free models (about 50 requests a day on a free account): the fallback.
OPENROUTER_API_KEY=
LLM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_OPENROUTER_API_KEY=${OPENROUTER_API_KEY}
LLM_OPENROUTER_MODEL=google/gemma-4-31b-it:free
LLM_OPENROUTER_FIRST_TOKEN_TIMEOUT_MS=60000

# Gemini: the free tier needs a key from a project WITHOUT billing (a prepaid project with no
# credits answers 402). Unpaid Gemini use may be used by Google to improve its products.
GEMINI_API_KEY=
LLM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_GEMINI_API_KEY=${GEMINI_API_KEY}
LLM_GEMINI_MODEL=gemini-flash-latest

# Optional per provider: LLM_<NAME>_MAX_TOKENS (6000), _TEMPERATURE (0.3), _REASONING_EFFORT,
# _FIRST_TOKEN_TIMEOUT_MS (45000). Anthropic: put "anthropic" in LLM_CHAIN with ANTHROPIC_API_KEY
# and CHRONICLE_MODEL (or leave LLM_CHAIN unset to use only those two).
ANTHROPIC_API_KEY=
CHRONICLE_MODEL=claude-sonnet-5

# 1 = hand-written fixtures instead of any LLM (wins over everything above)
MOCK_LLM=0
# With MOCK_LLM=1: wait this long before the first line, like a slow free model (checks the waiting state).
# MOCK_FIRST_DELAY_MS=12000

# ---------------------------------------------------------------- database, accounts, sync (sections 8-9)
# docker compose up -d db   (Postgres 16 + pgvector on port 5433). Without DATABASE_URL the app
# keeps lessons in the browser and has no accounts, review or turn log.
DATABASE_URL=postgres://chronicle:chronicle@localhost:5433/chronicle
BETTER_AUTH_SECRET=            # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_CHRONICLE_ACCOUNTS=1
# Google sign-in (optional): an OAuth client with redirect URI ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Real sign-in emails (optional): without these, development prints the link in the server log
RESEND_API_KEY=
EMAIL_FROM=Chronicle <signin@your-domain.example>
# Only for local test runs of a production build (scripts/e2e.ts): print sign-in links. Never deploy with it.
AUTH_LOG_LINKS=0
# who may open /admin/turns in production
ADMIN_EMAILS=

# ---------------------------------------------------------------- knowledge base (section 6)
# npx tsx scripts/ingest.ts   fills it from content/corpus/wikipedia.txt
EMBED_BASE_URL=https://api.cloudflare.com/client/v4/accounts/${CLOUDFLARE_ACCOUNT_ID}/ai/v1
EMBED_API_KEY=${CLOUDFLARE_API_TOKEN}
EMBED_MODEL=@cf/baai/bge-m3
EMBED_DIM=1024
RAG_K=6
RAG_SOURCE_TOKENS=2200

# ---------------------------------------------------------------- limits and review (sections 7, 10)
TURNS_PER_DAY=60
GUEST_TURNS_PER_DAY=20
TURNS_PER_MINUTE=6
REVIEW_NEW_PER_DAY=10
